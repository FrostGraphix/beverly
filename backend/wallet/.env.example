# ─────────────────────────────────────────────────────────
# Beverly Wallet Backend — Environment
# Copy to .env.local and fill values. Never commit .env.local.
# ─────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
MONEY_WRITES_ENABLED=false
PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis (BullMQ queue + rate limit)
REDIS_URL=redis://localhost:6379

# Energy backend (existing CRM proxy target)
ENERGY_BACKEND_URL=
ENERGY_BEARER_TOKEN=
ENERGY_AUTHORIZATION_PASSWORD=
# Development-only safety net for meter lookup metadata from captured read-only contracts.
# Production keeps this disabled unless explicitly enabled for a controlled incident.
ENERGY_ENABLE_ARCHIVED_METER_FALLBACK=false

# Paystack
# Webhook signatures are HMAC-SHA512 over the raw body keyed with the SECRET key —
# there is no separate webhook secret to configure.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_WEBHOOK_URL=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_TOKEN_SMS_FROM_NUMBER=
TWILIO_TOKEN_SMS_MESSAGING_SERVICE_SID=
SMS_ALLOWED_COUNTRY_CODES=+234
SMS_BLOCKED_COUNTRY_CODES=
SMS_HIGH_RISK_COUNTRY_CODES=+234
SMS_OTP_RATE_LIMIT_MAX=2
SMS_OTP_RATE_LIMIT_WINDOW_SECONDS=900
SMS_OTP_RESEND_COOLDOWN_SECONDS=60
SMS_TOKEN_RESEND_COOLDOWN_SECONDS=900
SMS_TOKEN_RESEND_DAILY_MAX=3

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=Beverly <noreply@acoblighting.com>
CUSTOMER_APP_URL=https://beverly.acoblighting.com
VENDOR_PORTAL_URL=https://vendor.beverly.acoblighting.com
STAFF_PORTAL_URL=https://beverly.acoblighting.com/wallet-admin

# Installed-device notifications. Generate once using: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@acoblighting.com
# This backend's own public URL (Fly.io app URL or custom domain), used to build
# an absolute logo image URL for emails. Leave blank until deployed.
EMAIL_ASSET_BASE_URL=

# Encryption (required in production; rotate independently)
APP_ENCRYPTION_KEY=

# Feature flags
FEATURE_CUSTOMER_WALLET=true
FEATURE_METER_PURCHASE=true
FEATURE_VENDOR_VENDING=true
VENDING_VAT_BASIS_POINTS=750
