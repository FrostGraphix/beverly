{
  "name": "@beverly/wallet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Beverly Wallet Ecosystem — dedicated Fastify backend service",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/emails/assets','dist/emails/assets',{recursive:true})\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "docker:up": "docker compose up --build",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@beverly/tokens": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "9.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^5.12.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.4.1",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0",
    "resend": "^4.8.0",
    "twilio": "^5.13.1",
    "web-push": "3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
