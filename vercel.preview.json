{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "CORS_ORIGINS": "https://acob-beverly.vercel.app,https://admin-acob-beverly.vercel.app,https://vendor-acob-beverly.vercel.app,https://customer-acob-beverly.vercel.app,https://beverly.acoblighting.com,https://vendor.beverly.acoblighting.com"
  },
  "functions": {
    "api/reference.js": {
      "excludeFiles": "{tmp,docs,tests,assets,backend/data,replica-screenshots,source-crawl,legacy-reference-app}/**"
    },
    "api/[...path].js": {
      "excludeFiles": "{tmp,docs,tests,assets,backend/data,replica-screenshots,source-crawl,legacy-reference-app}/**"
    }
  },
  "redirects": [
    { "source": "/wallet-admin", "destination": "/wallet-admin/", "permanent": true },
    { "source": "/wallet-vendor", "destination": "/wallet-vendor/", "permanent": true },
    { "source": "/wallet-customer", "destination": "/wallet-customer/", "permanent": true },
    { "source": "/wallet", "destination": "/wallet/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/wallet?__pathname=/health" },
    { "source": "/ready", "destination": "/api/wallet?__pathname=/ready" },
    { "source": "/api/v1/health", "destination": "/api/wallet?__pathname=/health" },
    { "source": "/api/v1/ready", "destination": "/api/wallet?__pathname=/ready" },
    { "source": "/assets/beverly-logo.png", "destination": "/api/wallet?__pathname=/assets/beverly-logo.png" },
    { "source": "/api/v1/admin/:path*", "destination": "/api/wallet?__pathname=/api/v1/admin/:path*" },
    { "source": "/api/v1/public/:path*", "destination": "/api/wallet?__pathname=/api/v1/public/:path*" },
    { "source": "/api/v1/webhook/:path*", "destination": "/api/wallet?__pathname=/api/v1/webhook/:path*" },
    { "source": "/api/v1/acobot/:path*", "destination": "/api/wallet?__pathname=/api/v1/acobot/:path*" },
    { "source": "/api/v1/customer/:path*", "destination": "/api/wallet?__pathname=/api/v1/customer/:path*" },
    { "source": "/api/v1/vendor/:path*", "destination": "/api/wallet?__pathname=/api/v1/vendor/:path*" },
    { "source": "/api/:path*", "destination": "/api/reference?__pathname=/api/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "admin-acob-beverly.vercel.app" }], "destination": "/wallet-admin/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "vendor-acob-beverly.vercel.app" }], "destination": "/wallet-vendor/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "customer-acob-beverly.vercel.app" }], "destination": "/wallet-customer/index.html" },
    { "source": "/crm", "destination": "/index.html" },
    { "source": "/crm/", "destination": "/index.html" },
    { "source": "/crm/:path*", "destination": "/index.html" },
    { "source": "/beverly", "destination": "/index.html" },
    { "source": "/beverly/", "destination": "/index.html" },
    { "source": "/beverly/:path*", "destination": "/index.html" },
    { "source": "/wallet", "destination": "/wallet/index.html" },
    { "source": "/wallet/", "destination": "/wallet/index.html" },
    { "source": "/wallet/:path*", "destination": "/wallet/index.html" },
    { "source": "/wallet-admin", "destination": "/wallet-admin/index.html" },
    { "source": "/wallet-admin/", "destination": "/wallet-admin/index.html" },
    { "source": "/wallet-admin/:path*", "destination": "/wallet-admin/index.html" },
    { "source": "/wallet-vendor", "destination": "/wallet-vendor/index.html" },
    { "source": "/wallet-vendor/", "destination": "/wallet-vendor/index.html" },
    { "source": "/wallet-vendor/:path*", "destination": "/wallet-vendor/index.html" },
    { "source": "/wallet-customer", "destination": "/wallet-customer/index.html" },
    { "source": "/wallet-customer/", "destination": "/wallet-customer/index.html" },
    { "source": "/wallet-customer/:path*", "destination": "/wallet-customer/index.html" },
    { "source": "/((?!api/).*)", "destination": "/wallet/index.html" }
  ]
}
