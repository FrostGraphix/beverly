{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/reference.js": {
      "maxDuration": 300,
      "excludeFiles": "{tmp,docs,tests,assets,backend/data,replica-screenshots,source-crawl,legacy-reference-app}/**"
    },
    "api/receipt-pdf.js": {
      "maxDuration": 60,
      "memory": 2048,
      "excludeFiles": "{tmp,docs,tests,assets,backend/data,replica-screenshots,source-crawl,legacy-reference-app}/**"
    },
    "api/[...path].js": {
      "excludeFiles": "{tmp,docs,tests,assets,backend/data,replica-screenshots,source-crawl,legacy-reference-app}/**"
    }
  },
  "crons": [
    { "path": "/api/cron/refresh-hot", "schedule": "0 6 * * *" },
    { "path": "/api/cron/refresh-hourly", "schedule": "0 12 * * *" },
    { "path": "/api/cron/refresh-daily", "schedule": "0 23 * * *" },
    { "path": "/api/cron/refresh-backfill", "schedule": "0 18 * * *" },
    { "path": "/api/cron/consumption-sync", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://qpoipyqgrjsjdvfqmxok.supabase.co wss://qpoipyqgrjsjdvfqmxok.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/wallet-admin", "destination": "/wallet-admin/", "permanent": true },
    { "source": "/wallet-vendor", "destination": "/wallet-vendor/", "permanent": true },
    { "source": "/wallet-customer", "destination": "/wallet-customer/", "permanent": true },
    { "source": "/wallet", "destination": "/wallet/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/wallet-service/:path*", "destination": "/api/wallet-service" },
    { "source": "/api/receipt-pdf", "destination": "/api/receipt-pdf" },
    { "source": "/api/:path*", "destination": "/api/reference?__pathname=/api/:path*" },
    { "source": "/wallet", "destination": "/wallet/index.html" },
    { "source": "/wallet/", "destination": "/wallet/index.html" },
    { "source": "/wallet/:path*", "destination": "/wallet/index.html" },
    { "source": "/wallet-admin", "destination": "/wallet-admin/index.html" },
    { "source": "/wallet-admin/", "destination": "/wallet-admin/index.html" },
    { "source": "/wallet-admin/:path*", "destination": "/wallet-admin/index.html" },
    { "source": "/wallet-vendor", "destination": "/wallet-vendor/index.html" },
    { "source": "/wallet-vendor/", "destination": "/wallet-vendor/index.html" },
    { "source": "/wallet-vendor/:path*", "destination": "/wallet-vendor/index.html" },
    { "source": "/wallet-customer", "destination": "/wallet-customer/index.html" },
    { "source": "/wallet-customer/", "destination": "/wallet-customer/index.html" },
    { "source": "/wallet-customer/:path*", "destination": "/wallet-customer/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "admin-acob-beverly.vercel.app" }], "destination": "/wallet-admin/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "vendor-acob-beverly.vercel.app" }], "destination": "/wallet-vendor/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "customer-acob-beverly.vercel.app" }], "destination": "/wallet-customer/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
