{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/reference.js": {
      "excludeFiles": "{tmp,docs,tests,assets,backend/data,replica-screenshots,source-crawl,legacy-reference-app}/**"
    },
    "api/[...path].js": {
      "excludeFiles": "{tmp,docs,tests,assets,backend/data,replica-screenshots,source-crawl,legacy-reference-app}/**"
    }
  },
  "crons": [
    { "path": "/api/cron/refresh-hot", "schedule": "0 6 * * *" },
    { "path": "/api/cron/refresh-hourly", "schedule": "0 12 * * *" },
    { "path": "/api/cron/refresh-daily", "schedule": "0 23 * * *" },
    { "path": "/api/cron/refresh-backfill", "schedule": "0 18 * * *" },
    { "path": "/api/cron/consumption-sync", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/api/wallet-service/:path*", "destination": "/api/wallet-service" },
    { "source": "/api/:path*", "destination": "/api/reference?__pathname=/api/:path*" },
    { "source": "/wallet", "destination": "/wallet/index.html" },
    { "source": "/wallet/:path*", "destination": "/wallet/index.html" },
    { "source": "/wallet-admin", "destination": "/wallet-admin/index.html" },
    { "source": "/wallet-admin/:path*", "destination": "/wallet-admin/index.html" },
    { "source": "/wallet-vendor", "destination": "/wallet-vendor/index.html" },
    { "source": "/wallet-vendor/:path*", "destination": "/wallet-vendor/index.html" },
    { "source": "/wallet-customer", "destination": "/wallet-customer/index.html" },
    { "source": "/wallet-customer/:path*", "destination": "/wallet-customer/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "admin-acob-beverly.vercel.app" }], "destination": "/wallet-admin/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "vendor-acob-beverly.vercel.app" }], "destination": "/wallet-vendor/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "customer-acob-beverly.vercel.app" }], "destination": "/wallet-customer/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
